# TürkLogos Telecom AI Agent Environment Variables
# TEKNOFEST 2025 Competition Project

# =====================================================
# AI/LLM Configuration
# =====================================================

# LLM Provider: GROQ ONLY for fast testing! 🚀
LLM_PROVIDER=groq

# Groq Configuration (FAST, cloud-based) ⚡
# Get your FREE API key from: https://console.groq.com/keys
# REQUIRED for testing - no fallbacks!
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Ollama Configuration (DISABLED - too slow for testing)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Alternative OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# =====================================================
# Database Configuration
# =====================================================

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:4Lt0g@localhost:5433/turklogos_db

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# =====================================================
# Security Configuration
# =====================================================

# Secret key for JWT tokens (change in production)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =====================================================
# Application Configuration
# =====================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =====================================================
# Agent Configuration
# =====================================================

# Maximum conversation length
MAX_CONVERSATION_LENGTH=50

# Default response timeout (seconds)
DEFAULT_RESPONSE_TIMEOUT=30

# Maximum iterations for agent
MAX_ITERATIONS=10

# =====================================================
# TEKNOFEST 2025 Specific
# =====================================================

# Competition mode settings
COMPETITION_MODE=true
DEMO_DATA_ENABLED=true

# Performance metrics collection
COLLECT_METRICS=true
METRICS_EXPORT_INTERVAL=300
